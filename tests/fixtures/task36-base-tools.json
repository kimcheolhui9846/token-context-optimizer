{
  "baseCommit": "f4fa22c5993a34961777871c9dd6fa9a9b93f748",
  "captureCommand": "node .artifacts/capture-tools.mjs (bundle: git show f4fa22c:bin/token-context-optimizer.mjs)",
  "tools": [
    {
      "name": "estimate_context",
      "description": "Estimate text tokens with profile metadata. Estimates are not billing usage.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "text": {
            "type": "string"
          },
          "maxTokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "text"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "estimatedTokens": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "maxTokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "fitsBudget": {
            "type": "boolean"
          },
          "profileVersion": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "estimatedTokens",
          "maxTokens",
          "fitsBudget",
          "profileVersion",
          "confidence",
          "warnings"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "classify_context",
      "description": "Classify context as exact, semantic, or visual before any compression.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "exact",
              "semantic",
              "visual",
              "unknown"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "mode",
          "reasons",
          "warnings"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "index_artifact",
      "description": "Index a local UTF-8 text artifact by SHA-256 and line source map.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "byteLength": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "lineCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "artifactId",
          "path",
          "sha256",
          "byteLength",
          "lineCount",
          "label"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "query_artifact",
      "description": "Return bounded source excerpts for an indexed artifact with line evidence.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "maxTokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2000
          },
          "contextLines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "artifactId",
          "query",
          "maxTokens"
        ]
      }
    },
    {
      "name": "summarize_artifact",
      "description": "Create a bounded extractive summary only when exact-content policy allows it.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "maxTokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2000
          }
        },
        "required": [
          "artifactId",
          "maxTokens"
        ]
      }
    },

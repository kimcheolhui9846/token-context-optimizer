          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "byteLength": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "lineCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991

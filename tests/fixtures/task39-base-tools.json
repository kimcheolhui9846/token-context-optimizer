    {
      "name": "query_artifact",
      "description": "Return bounded source excerpts for an indexed artifact with line evidence.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "maxTokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2000
          },
          "contextLines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "artifactId",
          "query",
          "maxTokens"
        ]
      }
    },
    {
      "name": "summarize_artifact",

  "tools": [
    {
      "name": "estimate_context",
      "description": "Estimate text tokens with profile metadata. Estimates are not billing usage.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "text": {
            "type": "string"
          },
          "maxTokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "text"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "estimatedTokens": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "maxTokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "fitsBudget": {
            "type": "boolean"
          },
          "profileVersion": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "estimatedTokens",
          "maxTokens",
          "fitsBudget",
          "profileVersion",
          "confidence",
          "warnings"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "classify_context",
      "description": "Classify context as exact, semantic, or visual before any compression.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "exact",
              "semantic",
              "visual",
              "unknown"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "mode",
          "reasons",
          "warnings"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "index_artifact",
      "description": "Index a local UTF-8 text artifact by SHA-256 and line source map.",
